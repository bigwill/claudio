{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claudio",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "SessionDO" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],

  "observability": { "enabled": true },

  // ---------------------------------------------------------------------
  // Environments
  //
  //   default (this file's top level) — the `develop` branch, served at
  //     claudio.<subdomain>.workers.dev. Deploy with `npm run deploy`.
  //
  //   production — the `main` branch, served at claudio.humble.audio.
  //     Deploy with `npm run deploy:prod`.
  //
  // Production is a SEPARATE Worker (claudio-prod), which means a separate
  // Durable Object namespace and separate secrets. That's deliberate: dev
  // iteration can't disturb live sessions, and a `npm run deploy` from a
  // half-finished branch can't reach the custom domain.
  //
  // assets / durable_objects / migrations are NOT inherited into an
  // environment — they must be repeated here or the production Worker
  // deploys without them.
  // ---------------------------------------------------------------------
  "env": {
    "production": {
      "name": "claudio-prod",

      // Reachable at claudio-prod.<subdomain>.workers.dev until the custom
      // domain is sorted. Without this, production has no route at all and is
      // simply unreachable — which is where it sat after the first deploy
      // attempt failed to attach the route.
      "workers_dev": true,

      // TODO: re-enable once Cloudflare is authoritative for the hostname.
      //
      //   "routes": [{ "pattern": "claudio.humble.audio", "custom_domain": true }],
      //
      // This line CANNOT be enabled until claudio.humble.audio is a zone on
      // this Cloudflare account (deploy fails: "Could not find zone"). A CNAME
      // at an external registrar pointing to *.workers.dev does not work as a
      // substitute: the browser sends SNI for claudio.humble.audio and
      // Cloudflare has no certificate for it, so TLS fails before routing is
      // ever considered. Cloudflare must hold the zone to issue that cert.
      // See README "Custom domain prerequisite".
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "durable_objects": {
        "bindings": [{ "name": "SESSION", "class_name": "SessionDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
      "observability": { "enabled": true }
    }
  }
}
