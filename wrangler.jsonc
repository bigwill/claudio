{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claudio",
  "compatibility_date": "2026-08-14",

  // ---------------------------------------------------------------------
  // Static assets only.
  //
  // There is no `main` any more, and no Durable Objects: the backend moved to
  // Convex, and Cloudflare's whole job is serving the built client. The browser
  // talks to Convex directly over a WebSocket, so nothing here proxies an API.
  //
  // `directory` is NOT optional — the Vite plugin used to supply it, and without
  // it an assets-only deploy uploads nothing at all.
  //
  // `not_found_handling` is what makes /<SESSION_ID> work: those paths have no
  // file behind them and must fall through to index.html.
  // ---------------------------------------------------------------------
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true },

  // ---------------------------------------------------------------------
  // Environments
  //
  //   default (this file's top level) — the `develop` branch, served at
  //     claudio.<subdomain>.workers.dev. Deploy with `npm run deploy`.
  //
  //   production — the `main` branch. Deploy with `npm run deploy:prod`.
  //
  // Each environment points at its OWN Convex deployment, and that URL is baked
  // into the bundle at build time via VITE_CONVEX_URL — so the build and the
  // deploy have to agree. That is the one footgun this file still has; see the
  // deploy scripts, which set it explicitly rather than relying on .env.local.
  //
  // assets is NOT inherited into an environment — it must be repeated here or
  // the production Worker deploys without it.
  // ---------------------------------------------------------------------
  "env": {
    // Claudio Band (feature/band), for showing people. Its own worker, so the
    // `claudio` and `claudio-prod` workers stay as they are for interviews.
    // Backed by the Convex cloud deployment in .env.band (VITE_CONVEX_URL).
    "band": {
      "name": "claudio-band",
      "workers_dev": true,

      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "observability": { "enabled": true }
    },

    "production": {
      "name": "claudio-prod",
      "workers_dev": true,

      // TODO: re-enable once Cloudflare is authoritative for the hostname.
      //
      //   "routes": [{ "pattern": "claudio.humble.audio", "custom_domain": true }],
      //
      // Unchanged by the Convex port: Cloudflare still terminates TLS for the
      // static site, so this still requires claudio.humble.audio to be a zone on
      // this account. A CNAME at an external registrar cannot substitute — the
      // browser sends SNI for claudio.humble.audio and Cloudflare holds no
      // certificate for it, so TLS fails before routing is considered.
      // See README "Custom domain prerequisite".
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "observability": { "enabled": true }
    }
  }
}
