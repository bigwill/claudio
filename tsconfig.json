{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "vite/client"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // scripts/ is deliberately excluded: those are Node-only dev utilities run
  // through node's type stripper, and they'd need @types/node globals that
  // conflict with the Workers/DOM lib set the app compiles against. They're
  // verified by being run (npm run test:dsp / npm run analyze), not by tsc.
  "include": ["src", "vite.config.ts", "worker-configuration.d.ts"]
}
