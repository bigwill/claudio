{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // scripts/ is deliberately excluded: those are Node-only dev utilities run
  // through node's type stripper, and they'd need @types/node globals that
  // conflict with the DOM lib set the app compiles against. They're verified by
  // being run (npm run test:dsp / npm run analyze), not by tsc.
  //
  // convex/ IS included: its functions import src/shared, so a change there that
  // breaks the backend should fail here rather than at push time. (The Workers
  // types are gone with the Worker — the backend is Convex now.)
  "include": ["src", "convex", "vite.config.ts"]
}
